<Window x:Class="GlueDock.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/GlueDock.png"
        Title="About GlueDock"
        Width="500"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF202020">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse Width="78"
                     Height="78"
                     Stroke="#FF3498DB"
                     StrokeThickness="2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">
                <Ellipse.Fill>
                    <ImageBrush x:Name="MolotovImageBrush"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0">
                <TextBlock Text="GlueDock"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="Copyright © Daniel Capilla"
                           Foreground="White"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="VersionText"
                           Foreground="White"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="UpdateStatusText"
                           Foreground="White"
                           Margin="0,4,0,0" />
                <TextBlock Margin="0,8,0,0">
                    <Hyperlink Foreground="#FF73BFFF"
                               NavigateUri="https://github.com/UncleRiot/GlueDock"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        https://github.com/UncleRiot/GlueDock
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink Foreground="#FF73BFFF"
                               NavigateUri="https://github.com/UncleRiot/GlueDock/releases"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        Releases: https://github.com/UncleRiot/GlueDock/releases
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1"
                   Margin="0,18,0,14" />

        <TextBlock Grid.Row="2"
                   Foreground="White"
                   TextWrapping="Wrap"
                   Text="GlueDock can be used free of charge. If this tool helps you, you can support development here:" />

        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Image x:Name="KoFiImage"
                   Width="143.2"
                   Height="33.6"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Cursor="Hand"
                   MouseLeftButtonUp="KoFiImage_MouseLeftButtonUp" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="OpenReleaseButton"
                        Content="Open release"
                        Width="110"
                        Height="33.6"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="OpenReleaseButton_Click" />
                <Button Content="OK"
                        Width="90"
                        Height="33.6"
                        IsDefault="True"
                        Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
