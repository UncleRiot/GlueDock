<Window x:Class="GlueDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Icon="Resources/GlueDock.png"
        Title="GlueDock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True">

    <Window.Resources>
        <SolidColorBrush x:Key="DockItemBackgroundBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="DockItemBorderBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="DockTextBrush"
                         Color="#FFFFFF" />
        <SolidColorBrush x:Key="DragGhostBackgroundBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="DragGhostBorderBrush"
                         Color="#66FFFFFF" />
        <Thickness x:Key="DockItemMargin">0,3,0,3</Thickness>
        <sys:Double x:Key="DockItemWidth">64</sys:Double>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="NewSubmenuContextMenuItem"
                      Header="New GlueDock submenu"
                      Click="NewSubmenu_Click" />
            <Separator />
            <MenuItem x:Name="SettingsContextMenuItem"
                      Header="Settings"
                      Click="OpenSettings_Click" />
            <MenuItem x:Name="AboutContextMenuItem"
                      Header="About"
                      Click="About_Click" />
            <Separator />
            <MenuItem x:Name="ExitContextMenuItem"
                      Header="Exit"
                      Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="DockChrome"
            Margin="0"
            Padding="10"
            CornerRadius="20"
            Background="#6612161C"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">

        <Grid>
            <Border x:Name="DockGlassSurface"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Border x:Name="DockGlassHighlight"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Grid x:Name="DockContentGrid">
            <ItemsControl x:Name="DockItemsControl"
                      ItemsSource="{Binding DockItems}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="DockItemBorder"
                            Width="{DynamicResource DockItemWidth}"
                            Height="58"
                            Margin="{DynamicResource DockItemMargin}"
                            ClipToBounds="True"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="{Binding DisplayName}"
                            PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="DockItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="DockItem_PreviewMouseLeftButtonUp"
                            MouseEnter="DockItem_MouseEnter"
                            MouseLeave="DockItem_MouseLeave">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Click="RenameDockItem_Click"
                                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Change icon..."
                                          Click="ChangeDockItemIcon_Click"
                                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="Use default icon"
                                          Click="UseDefaultDockItemIcon_Click"
                                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Remove"
                                          Click="RemoveDockItem_Click"
                                          Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Settings"
                                          Click="OpenSettings_Click" />
                                <MenuItem Header="About"
                                          Click="About_Click" />
                                <Separator />
                                <MenuItem Header="Exit"
                                          Click="Exit_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid>
                            <Border x:Name="DockItemHighlight"
                                    Width="{DynamicResource DockItemWidth}"
                                    Height="62"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Image Source="{Binding Icon}"
                                   Width="40"
                                   Height="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBlock x:Name="DockItemLabel"
                                           Grid.Row="1"
                                           Text="{Binding DisplayName}"
                                           Margin="3,3,3,0"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11"
                                           Foreground="{DynamicResource DockTextBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="DragGhost"
                    Width="58"
                    Height="58"
                    CornerRadius="14"
                    Background="{DynamicResource DragGhostBackgroundBrush}"
                    BorderBrush="{DynamicResource DragGhostBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.92"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image x:Name="DragGhostImage"
                           Width="40"
                           Height="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock x:Name="DragGhostLabel"
                               Grid.Row="1"
                               Margin="2,3,2,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="72"
                               FontSize="11"
                               Foreground="{DynamicResource DockTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
