<Window x:Class="GlueDock.SubDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Icon="Resources/GlueDock.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SubDockItemBackgroundBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SubDockItemBorderBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SubDockTextBrush"
                         Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubDockIndicatorBrush"
                         Color="#FFFFFF" />
        <Thickness x:Key="SubDockItemMargin">0,3,0,3</Thickness>
        <sys:Double x:Key="SubDockItemWidth">64</sys:Double>
    </Window.Resources>

    <Border x:Name="SubDockChrome"
            Padding="10"
            CornerRadius="20"
            BorderThickness="1"
            Background="#6612161C"
            BorderBrush="#66FFFFFF"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="SubDockGlassSurface"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Border x:Name="SubDockGlassHighlight"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Grid x:Name="SubDockContentGrid">
            <ItemsControl x:Name="SubDockItemsControl"
                          ItemsSource="{Binding Items}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="SubDockItemBorder"
                                Width="{DynamicResource SubDockItemWidth}"
                                Height="58"
                                Margin="{DynamicResource SubDockItemMargin}"
                                ClipToBounds="True"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="SubDockItem_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="SubDockItem_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="SubDockItem_PreviewMouseLeftButtonUp"
                                MouseEnter="SubDockItem_MouseEnter"
                                MouseLeave="SubDockItem_MouseLeave">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename"
                                              Click="RenameItem_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Change icon..."
                                              Click="ChangeItemIcon_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Use default icon"
                                              Click="UseDefaultItemIcon_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Remove"
                                              Click="RemoveItem_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Border x:Name="SubDockItemHighlight"
                                        Width="{DynamicResource SubDockItemWidth}"
                                        Height="62"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image Source="{Binding Icon}"
                                       Width="40"
                                       Height="40"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBlock x:Name="SubDockItemLabel"
                                           Grid.Row="1"
                                           Text="{Binding DisplayName}"
                                           Margin="3,3,3,0"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubDockTextBrush}"
                                           Visibility="Collapsed" />

                                    <TextBlock Text="›"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SubDockIndicatorBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubmenu}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="SubDockDragGhost"
                    Width="58"
                    Height="58"
                    CornerRadius="14"
                    Background="{DynamicResource SubDockItemBackgroundBrush}"
                    BorderBrush="{DynamicResource SubDockItemBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.92"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image x:Name="SubDockDragGhostImage"
                           Width="40"
                           Height="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock x:Name="SubDockDragGhostLabel"
                               Grid.Row="1"
                               Margin="2,3,2,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="72"
                               FontSize="11"
                               Foreground="{DynamicResource SubDockTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="NewSubmenuContextMenuItem"
                              Header="New GlueDock submenu"
                              Click="NewSubmenu_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
            </Grid>
        </Grid>
    </Border>
</Window>
