<Window x:Class="GlueDock.SubDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Icon="Resources/GlueDock.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SubDockItemBackgroundBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SubDockItemBorderBrush"
                         Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SubDockTextBrush"
                         Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubDockIndicatorBrush"
                         Color="#FFFFFF" />
        <Thickness x:Key="SubDockItemMargin">0,3,0,3</Thickness>
        <sys:Double x:Key="SubDockItemWidth">64</sys:Double>
        <sys:Double x:Key="SubDockItemHeight">58</sys:Double>
    </Window.Resources>

    <Border x:Name="SubDockChrome"
            Padding="10"
            CornerRadius="20"
            BorderThickness="1"
            Background="#6612161C"
            BorderBrush="#66FFFFFF"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="SubDockGlassSurface"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Canvas x:Name="SubDockGlassFlames"
                    Margin="-10"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Visibility="Collapsed" />

            <Canvas x:Name="SubDockGlassStars"
                    Margin="-10"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Visibility="Collapsed" />

            <Border x:Name="SubDockGlassHighlight"
                    Margin="-10"
                    CornerRadius="20"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <Grid x:Name="SubDockContentGrid">
                <Border x:Name="LayoutAdjustmentNotice"
                        Panel.ZIndex="1000"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        Padding="10,6"
                        CornerRadius="10"
                        Background="#CC202020"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        Opacity="0"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="LayoutAdjustmentNoticeText"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxWidth="320" />
                </Border>
            <ContentPresenter x:Name="SubDockCompanionHost"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed" />

            <ItemsControl x:Name="SubDockItemsControl"
                          ItemsSource="{Binding Items}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel x:Name="SubDockItemsWrapPanel"
                                   Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="SubDockItemBorder"
                                Width="{DynamicResource SubDockItemWidth}"
                                Height="{DynamicResource SubDockItemHeight}"
                                Margin="{DynamicResource SubDockItemMargin}"
                                ClipToBounds="True"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="{Binding DisplayName}"
                                PreviewMouseLeftButtonDown="SubDockItem_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="SubDockItem_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="SubDockItem_PreviewMouseLeftButtonUp"
                                MouseEnter="SubDockItem_MouseEnter"
                                MouseLeave="SubDockItem_MouseLeave">
                            <Border.ContextMenu>
                                <ContextMenu Opened="DockItemContextMenu_Opened">
                                    <MenuItem Header="Rename"
                                              Click="RenameItem_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Change icon..."
                                              Click="ChangeItemIcon_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem Header="Use default icon"
                                              Click="UseDefaultItemIcon_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsSubmenu, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem x:Name="StartAsAdministratorMenuItem"
                                              Header="Start as Administrator"
                                              Click="StartDockItemAsAdministrator_Click"
                                              Visibility="Collapsed"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem x:Name="WidgetActionsMenuItem"
                                              Header="Widget">
                                        <MenuItem x:Name="WidgetDragDropLockMenuItem"
                                                  IsCheckable="True"
                                                  Click="WidgetDragDropLockMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem x:Name="WidgetSettingsMenuItem"
                                                  Header="Settings"
                                                  Click="OpenWidgetSettings_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem x:Name="WidgetAlarmMenuItem"
                                                  Header="Alarm clock"
                                                  Click="OpenWidgetAlarm_Click"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsWidgetAlarmActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem x:Name="WidgetTimerMenuItem"
                                                  Header="Timer"
                                                  Click="OpenWidgetTimer_Click"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsWidgetTimerActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem x:Name="WidgetStopwatchMenuItem"
                                                  Header="Stopwatch"
                                                  Click="OpenWidgetStopwatch_Click"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsWidgetStopwatchActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem x:Name="WidgetCalendarMenuItem"
                                                  Header="Calendar"
                                                  Click="OpenWidgetCalendar_Click"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsWidgetCalendarActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="DisableAutohideMenuItem"
                                              Header="Disable autohide"
                                              IsCheckable="True"
                                              Click="DisableAutohideMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Remove"
                                              Click="RemoveItem_Click"
                                              Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Border x:Name="SubDockItemHighlight"
                                        Width="{DynamicResource SubDockItemWidth}"
                                        Height="62"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image x:Name="SubDockItemIcon"
                                           Source="{Binding Icon}"
                                           Width="40"
                                           Height="40"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <ContentPresenter x:Name="SubDockItemWidgetHost"
                                                      Grid.RowSpan="2"
                                                      Content="{Binding WidgetView}"
                                                      Width="52"
                                                      Height="52"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource SubDockTextBrush}"
                                                      Visibility="Collapsed" />

                                <TextBlock x:Name="SubDockItemLabel"
                                           Grid.Row="1"
                                           Text="{Binding DisplayName}"
                                           Margin="3,3,3,0"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11"
                                           Foreground="{DynamicResource SubDockTextBrush}"
                                           Visibility="Collapsed" />

                                    <TextBlock Text="›"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SubDockIndicatorBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubmenu}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWidget}"
                                         Value="True">
                                <Setter TargetName="SubDockItemIcon"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="SubDockItemWidgetHost"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="SubDockDragGhost"
                    Width="58"
                    Height="58"
                    CornerRadius="14"
                    Background="{DynamicResource SubDockItemBackgroundBrush}"
                    BorderBrush="{DynamicResource SubDockItemBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Opacity="0.92"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image x:Name="SubDockDragGhostImage"
                           Width="40"
                           Height="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock x:Name="SubDockDragGhostLabel"
                               Grid.Row="1"
                               Margin="2,3,2,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="72"
                               FontSize="11"
                               Foreground="{DynamicResource SubDockTextBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="NewSubmenuContextMenuItem"
                              Header="New GlueDock submenu"
                              Click="NewSubmenu_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
            </Grid>
        </Grid>
    </Border>
</Window>
