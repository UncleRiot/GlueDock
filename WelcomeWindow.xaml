<Window x:Class="GlueDock.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/GlueDock.png"
        Width="560"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF202020">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse Width="78"
                     Height="78"
                     Stroke="#FF3498DB"
                     StrokeThickness="2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">
                <Ellipse.Fill>
                    <ImageBrush x:Name="MolotovImageBrush"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0">
                <TextBlock x:Name="HeadingText"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Foreground="White"
                           Margin="0,8,0,0" />
                <TextBlock x:Name="LicenseInfoText"
                           Foreground="White"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1"
                   Margin="0,18,0,14" />

        <StackPanel Grid.Row="2">
            <Button x:Name="ViewLicenseButton"
                    Width="150"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="ViewLicenseButton_Click" />
            <CheckBox x:Name="AcknowledgeCheckBox"
                      Margin="0,12,0,0"
                      Foreground="White"
                      Checked="AcknowledgeCheckBox_Changed"
                      Unchecked="AcknowledgeCheckBox_Changed" />
        </StackPanel>

        <Separator Grid.Row="3"
                   Margin="0,16,0,14" />

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="SupportText"
                       Foreground="White"
                       TextWrapping="Wrap" />
            <Image x:Name="KoFiImage"
                   Width="143.2"
                   Height="33.6"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   Margin="0,12,0,0"
                   Cursor="Hand"
                   MouseLeftButtonUp="KoFiImage_MouseLeftButtonUp" />
        </StackPanel>

        <Button x:Name="ContinueButton"
                Grid.Row="5"
                Width="100"
                Height="33.6"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsEnabled="False"
                Click="ContinueButton_Click" />
    </Grid>
</Window>
