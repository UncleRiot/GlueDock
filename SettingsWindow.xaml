<Window x:Class="GlueDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlueDock Einstellungen"
        Width="650"
        Height="590"
        MinWidth="590"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FF171A20">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Allgemein">
                <StackPanel Margin="18">
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="Mit Windows starten"
                              Margin="0,0,0,16"
                              Checked="StartWithWindowsCheckBox_Changed"
                              Unchecked="StartWithWindowsCheckBox_Changed" />

                    <CheckBox x:Name="CollapseDisabledCheckBox"
                              Content="Zuklappen aus"
                              Margin="0,0,0,16"
                              Checked="CollapseDisabledCheckBox_Changed"
                              Unchecked="CollapseDisabledCheckBox_Changed" />

                    <TextBlock Text="Zuklappverzögerung" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <Slider x:Name="CollapseDelaySlider"
                                Width="360"
                                Minimum="0"
                                Maximum="3000"
                                TickFrequency="50"
                                IsSnapToTickEnabled="True"
                                ValueChanged="CollapseDelaySlider_ValueChanged" />
                        <TextBlock x:Name="CollapseDelayText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Darstellung">
                <StackPanel Margin="18">
                    <TextBlock Text="Rand-Leistenfarbe" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Border x:Name="BarColorPreview"
                                Width="46"
                                Height="26"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,10,0" />
                        <Button Content="Farbe wählen..."
                                Width="120"
                                Padding="8,4"
                                Click="ChooseBarColor_Click" />
                    </StackPanel>

                    <CheckBox x:Name="DockBorderEnabledCheckBox"
                              Content="Dock-Rahmen anzeigen"
                              Margin="0,0,0,10"
                              Checked="DockBorderEnabledCheckBox_Changed"
                              Unchecked="DockBorderEnabledCheckBox_Changed" />

                    <TextBlock Text="Dock-Rahmenfarbe" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Border x:Name="DockBorderColorPreview"
                                Width="46"
                                Height="26"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,10,0" />
                        <Button x:Name="DockBorderColorButton"
                                Content="Farbe wählen..."
                                Width="120"
                                Padding="8,4"
                                Click="ChooseDockBorderColor_Click" />
                    </StackPanel>

                    <TextBlock Text="Rand-Leistendicke" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="BarThicknessSlider"
                                Width="360"
                                Minimum="2"
                                Maximum="24"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BarThicknessSlider_ValueChanged" />
                        <TextBlock x:Name="BarThicknessText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Dock-Skalierung" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="DockScaleSlider"
                                Width="360"
                                Minimum="0.60"
                                Maximum="2.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DockScaleSlider_ValueChanged" />
                        <TextBlock x:Name="DockScaleText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Transparenz" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="OpacitySlider"
                                Width="360"
                                Minimum="0.10"
                                Maximum="1.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Animation" />
                    <ComboBox x:Name="AnimationStyleComboBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,0"
                              SelectionChanged="AnimationStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Fade"
                                      Tag="Fade" />
                        <ComboBoxItem Content="Slide"
                                      Tag="Slide" />
                        <ComboBoxItem Content="Zoom"
                                      Tag="Zoom" />
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Verhalten">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Reserviert für weitere Optionen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 01" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 02" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 03" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 04" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 05" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 06" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 07" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dock">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Reserviert für weitere Dock-Optionen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 08" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 09" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 10" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 11" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 12" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 13" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 14" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Erweitert">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Reserviert für weitere erweiterte Optionen"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 15" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 16" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 17" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 18" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 19" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 20" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Schließen"
                    Width="100"
                    Padding="10,6"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
