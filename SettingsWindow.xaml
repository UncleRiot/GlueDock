<Window x:Class="GlueDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/GlueDock.png"
        Title="GlueDock Einstellungen"
        Width="650"
        Height="590"
        MinWidth="590"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FF171A20">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem x:Name="GeneralTab" Header="General">
                <Grid Margin="18">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start with Windows"
                                  Margin="0,0,0,16"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />

                        <CheckBox x:Name="CollapseDisabledCheckBox"
                                  Content="Disable collapsing"
                                  Margin="0,0,0,16"
                                  Checked="CollapseDisabledCheckBox_Changed"
                                  Unchecked="CollapseDisabledCheckBox_Changed" />

                        <TextBlock x:Name="CollapseDelayLabel" Text="Collapse delay" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0">
                            <Slider x:Name="CollapseDelaySlider"
                                    Width="360"
                                    Minimum="0"
                                    Maximum="3000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="CollapseDelaySlider_ValueChanged" />
                            <TextBlock x:Name="CollapseDelayText"
                                       Width="90"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="SubdockCollapseDelayLabel"
                                   Text="Subdock collapse delay"
                                   Margin="0,18,0,0" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0">
                            <Slider x:Name="SubdockCollapseDelaySlider"
                                    Width="360"
                                    Minimum="0"
                                    Maximum="3000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SubdockCollapseDelaySlider_ValueChanged" />
                            <TextBlock x:Name="SubdockCollapseDelayText"
                                       Width="90"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="LanguageLabel"
                                   Text="Language"
                                   Margin="0,18,0,0" />
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Margin="0,6,0,0"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                    </StackPanel>

                    <Image Source="Resources/GlueDock_Settings_UnderConstruction.png"
                           Width="190"
                           Height="90"
                           Stretch="Uniform"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
                </Grid>
            </TabItem>

            <TabItem x:Name="AppearanceTab" Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                    <TextBlock x:Name="ThemeLabel"
                               Text="Theme" />
                    <ComboBox x:Name="ThemeComboBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,16"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              DropDownOpened="ThemeComboBox_DropDownOpened"
                              SelectionChanged="ThemeComboBox_SelectionChanged" />

                    <TextBlock x:Name="EdgeBarColorLabel" Text="Edge bar color" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Border x:Name="BarColorPreview"
                                Width="46"
                                Height="26"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,10,0" />
                        <Button x:Name="BarColorButton"
                                Content="Choose color..."
                                Width="120"
                                Padding="8,4"
                                Click="ChooseBarColor_Click" />
                    </StackPanel>

                    <CheckBox x:Name="DockBorderEnabledCheckBox"
                              Content="Show dock border"
                              Margin="0,0,0,10"
                              Checked="DockBorderEnabledCheckBox_Changed"
                              Unchecked="DockBorderEnabledCheckBox_Changed" />

                    <TextBlock x:Name="DockBorderColorLabel" Text="Dock border color" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Border x:Name="DockBorderColorPreview"
                                Width="46"
                                Height="26"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,10,0" />
                        <Button x:Name="DockBorderColorButton"
                                Content="Choose color..."
                                Width="120"
                                Padding="8,4"
                                Click="ChooseDockBorderColor_Click" />
                    </StackPanel>

                    <TextBlock x:Name="EdgeBarThicknessLabel" Text="Edge bar thickness" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="BarThicknessSlider"
                                Width="360"
                                Minimum="2"
                                Maximum="24"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BarThicknessSlider_ValueChanged" />
                        <TextBlock x:Name="BarThicknessText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="DockScaleLabel" Text="Dock scaling" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="DockScaleSlider"
                                Width="360"
                                Minimum="0.60"
                                Maximum="2.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DockScaleSlider_ValueChanged" />
                        <TextBlock x:Name="DockScaleText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="ItemSpacingLabel" Text="Item spacing" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="ItemSpacingSlider"
                                Width="360"
                                Minimum="10"
                                Maximum="60"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ItemSpacingSlider_ValueChanged" />
                        <TextBlock x:Name="ItemSpacingText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="DockThicknessScaleLabel" Text="Dock height" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="DockThicknessScaleSlider"
                                Width="360"
                                Minimum="0.50"
                                Maximum="1.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DockThicknessScaleSlider_ValueChanged" />
                        <TextBlock x:Name="DockThicknessScaleText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="ShowItemLabelsCheckBox"
                              Content="Show names below icons"
                              Margin="0,0,0,10"
                              Checked="ShowItemLabelsCheckBox_Changed"
                              Unchecked="ShowItemLabelsCheckBox_Changed" />

                    <CheckBox x:Name="ShowFilePreviewsCheckBox"
                              Content="Show file previews"
                              Margin="0,0,0,10"
                              Checked="ShowFilePreviewsCheckBox_Changed"
                              Unchecked="ShowFilePreviewsCheckBox_Changed" />

                    <CheckBox x:Name="UseSmallShortcutOverlayCheckBox"
                              Content="Use smaller shortcut arrow"
                              Margin="0,0,0,16"
                              Checked="UseSmallShortcutOverlayCheckBox_Changed"
                              Unchecked="UseSmallShortcutOverlayCheckBox_Changed" />

                    <TextBlock x:Name="OpacityLabel" Text="Opacity" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="OpacitySlider"
                                Width="360"
                                Minimum="0.10"
                                Maximum="1.00"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="BlurLabel" Text="Blur" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,16">
                        <Slider x:Name="BlurSlider"
                                Width="360"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BlurSlider_ValueChanged" />
                        <TextBlock x:Name="BlurText"
                                   Width="90"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="AnimationLabel" Text="Animation" />
                    <ComboBox x:Name="AnimationStyleComboBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,6,0,0"
                              SelectionChanged="AnimationStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Fade"
                                      Tag="Fade" />
                        <ComboBoxItem Content="Slide"
                                      Tag="Slide" />
                        <ComboBoxItem Content="Zoom"
                                      Tag="Zoom" />
                    </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="BehaviorTab" Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="HoverEffectLabel"
                                   Text="Hover effect" />
                        <ComboBox x:Name="HoverEffectComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Margin="0,6,0,24"
                                  SelectionChanged="HoverEffectComboBox_SelectionChanged">
                            <ComboBoxItem Content="None"
                                          Tag="None" />
                            <ComboBoxItem Content="Zoom"
                                          Tag="Zoom" />
                            <ComboBoxItem Content="Glow"
                                          Tag="Glow" />
                            <ComboBoxItem Content="Highlight"
                                          Tag="Highlight" />
                        </ComboBox>

                        <TextBlock x:Name="ReservedBehaviorLabel"
                                   Text="Reserved for additional options"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 01" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 02" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 03" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 04" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 05" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 06" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 07" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DockTab" Header="Dock">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="SubmenuIconLabel"
                                   Text="Subdock icon"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Border Width="52"
                                    Height="52"
                                    Margin="0,0,12,0"
                                    CornerRadius="8"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1">
                                <Image x:Name="SubmenuIconPreview"
                                       Width="40"
                                       Height="40"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel>
                                <Button x:Name="SubmenuWindowsIconButton"
                                        Content="Choose Windows icon..."
                                        Width="228"
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        Click="SubmenuWindowsIconButton_Click" />

                                <TextBlock x:Name="SubmenuWindowsIconSelectionText"
                                           Width="228"
                                           Margin="0,6,0,0"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button x:Name="SubmenuLoadImageButton"
                                            Content="Load image..."
                                            Width="110"
                                            Padding="8,4"
                                            Margin="0,0,8,0"
                                            Click="SubmenuLoadImageButton_Click" />

                                    <Button x:Name="SubmenuDefaultIconButton"
                                            Content="Use default"
                                            Width="110"
                                            Padding="8,4"
                                            Click="SubmenuDefaultIconButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="SubmenuRepositoryInfoText"
                                   Text="External images are copied to GlueDock_Repository\Icons."
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />

                        <TextBlock x:Name="ReservedDockLabel"
                                   Text="Reserved for additional dock options"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 08" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 09" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 10" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 11" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 12" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 13" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 14" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ProfilesTab" Header="Profiles">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Select a profile for live preview. Changes remain temporary until Apply is clicked."
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ListBox x:Name="ProfilesListBox"
                             Grid.Row="1"
                             MinHeight="180"
                             SelectionChanged="ProfilesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               Opacity="0.72"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2"
                               Margin="0,12,0,0">
                        <Button Content="New"
                                Width="95"
                                Margin="0,0,8,8"
                                Click="NewProfileButton_Click" />
                        <Button Content="Save current"
                                Width="110"
                                Margin="0,0,8,8"
                                Click="SaveProfileButton_Click" />
                        <Button Content="Rename"
                                Width="95"
                                Margin="0,0,8,8"
                                Click="RenameProfileButton_Click" />
                        <Button Content="Delete"
                                Width="95"
                                Margin="0,0,8,8"
                                Click="DeleteProfileButton_Click" />
                    </WrapPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <Button x:Name="CancelProfilePreviewButton"
                                Content="Cancel preview"
                                Width="120"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="CancelProfilePreviewButton_Click" />
                        <Button x:Name="ApplyProfileButton"
                                Content="Apply"
                                Width="100"
                                IsEnabled="False"
                                Click="ApplyProfileButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="AdvancedTab" Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <CheckBox x:Name="DebugLoggingCheckBox"
                                  Content="Enable debug logging"
                                  Margin="0,0,0,12"
                                  Checked="DebugLoggingCheckBox_Changed"
                                  Unchecked="DebugLoggingCheckBox_Changed" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Max size"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <Slider x:Name="DebugLogMaxSizeSlider"
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="10"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="DebugLogMaxSizeSlider_ValueChanged"
                                    Margin="0,0,12,0" />

                            <TextBlock x:Name="DebugLogMaxSizeText"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="10 MB" />
                        </Grid>

                        <TextBlock x:Name="DebugLoggingInfoText"
                                   Text="Brotli compressed, maximum 10 files"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18" />

                        <TextBlock x:Name="ReservedAdvancedLabel"
                                   Text="Reserved for additional advanced options"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <CheckBox Content="Option 15" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 16" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 17" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 18" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 19" IsEnabled="False" Margin="0,4"/>
                        <CheckBox Content="Option 20" IsEnabled="False" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="100"
                    Padding="10,6"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
