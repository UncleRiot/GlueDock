<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GlueNotes</AssemblyName>
    <RootNamespace>GlueNotes</RootNamespace>
    <DefineConstants>$(DefineConstants);GLUEDOCK_PLUGIN</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\$(Configuration)\net10.0-windows10.0.19041.0\GlueDock_Widgets\GlueNotes\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlueDock.WidgetApi\GlueDock.WidgetApi.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
