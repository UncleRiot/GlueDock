<Window x:Class="GlueNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title=""
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlueNotesTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="WindowBorder"
                BorderThickness="1"
                BorderBrush="{DynamicResource GlueNotesBorderBrush}"
                Background="{DynamicResource GlueNotesWindowBrush}"
                CornerRadius="4" />

        <Border x:Name="GlassSurfaceBorder"
                Background="Transparent"
                CornerRadius="4"
                IsHitTestVisible="False" />

        <Border x:Name="GlassHighlightBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="4"
                IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="30"
                  Margin="10,2,8,0"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WindowTitleText"
                           Margin="4,0,0,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Width="34"
                        Height="26"
                        Margin="0,0,4,0"
                        Padding="0"
                        FontFamily="Segoe MDL2 Assets"
                        Content=""
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="SettingsButton_Click" />

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="34"
                        Height="26"
                        Padding="0"
                        Content="×"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="16,4,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        BorderBrush="{DynamicResource GlueNotesBorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource GlueNotesSurfaceBrush}"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="NotesHeaderText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <Button x:Name="NewNoteButton"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="26"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content=""
                                    Click="NewNoteButton_Click" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox x:Name="NotesListBox"
                                     SelectionChanged="NotesListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UpdatedAtLocal, StringFormat={}{0:g}}"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource GlueNotesMutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="EmptyNotesText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlueNotesMutedTextBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        BorderBrush="{DynamicResource GlueNotesBorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource GlueNotesSurfaceBrush}"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TitleTextBox"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 TextChanged="TitleTextBox_TextChanged" />

                        <WrapPanel Grid.Row="2">
                            <Button x:Name="BoldButton"
                                    Width="34"
                                    Height="26"
                                    Margin="0,0,6,0"
                                    FontWeight="Bold"
                                    Content="B"
                                    Click="BoldButton_Click" />

                            <Button x:Name="ItalicButton"
                                    Width="34"
                                    Height="26"
                                    Margin="0,0,6,0"
                                    FontStyle="Italic"
                                    Content="I"
                                    Click="ItalicButton_Click" />

                            <Button x:Name="UnderlineButton"
                                    Width="34"
                                    Height="26"
                                    Margin="0,0,10,0"
                                    Content="U"
                                    Click="UnderlineButton_Click" />

                            <ComboBox x:Name="FontSizeComboBox"
                                      Width="72"
                                      Height="30"
                                      Margin="0,0,6,0"
                                      SelectionChanged="FontSizeComboBox_SelectionChanged" />

                            <Button x:Name="TextColorButton"
                                    Width="34"
                                    Height="26"
                                    Margin="0,0,10,0"
                                    Padding="6"
                                    Click="TextColorButton_Click">
                                <Border x:Name="TextColorPreview"
                                        Width="14"
                                        Height="14"
                                        Background="{DynamicResource GlueNotesTextBrush}"
                                        BorderBrush="{DynamicResource GlueNotesBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                            </Button>

                            <Button x:Name="InsertChecklistButton"
                                    Width="34"
                                    Height="26"
                                    Padding="0"
                                    FontFamily="Segoe MDL2 Assets"
                                    Content=""
                                    Click="InsertChecklistButton_Click" />
                        </WrapPanel>

                        <RichTextBox x:Name="EditorRichTextBox"
                                     Grid.Row="4"
                                     Padding="12"
                                     BorderBrush="{DynamicResource GlueNotesBorderBrush}"
                                     BorderThickness="1"
                                     Background="{DynamicResource GlueNotesSurfaceBrush}"
                                     Foreground="{DynamicResource GlueNotesTextBrush}"
                                     AcceptsTab="True"
                                     IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     DataObject.Pasting="EditorRichTextBox_Pasting"
                                     SelectionChanged="EditorRichTextBox_SelectionChanged"
                                     TextChanged="EditorRichTextBox_TextChanged" />

                        <TextBlock x:Name="SaveStatusText"
                                   Grid.Row="5"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource GlueNotesMutedTextBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
