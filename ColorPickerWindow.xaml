<Window x:Class="GlueDock.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farbe auswählen"
        Width="560"
        Height="520"
        MinWidth="560"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF4F4F4">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SaturationValueArea"
                  Grid.Column="0"
                  ClipToBounds="True"
                  Cursor="Cross"
                  MouseLeftButtonDown="SaturationValueArea_MouseLeftButtonDown"
                  MouseMove="SaturationValueArea_MouseMove"
                  MouseLeftButtonUp="SaturationValueArea_MouseLeftButtonUp">
                <Border x:Name="HueSurface" />

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5"
                                             EndPoint="1,0.5">
                            <GradientStop Color="#FFFFFFFF"
                                          Offset="0" />
                            <GradientStop Color="#00FFFFFF"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0"
                                             EndPoint="0.5,1">
                            <GradientStop Color="#00000000"
                                          Offset="0" />
                            <GradientStop Color="#FF000000"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Ellipse x:Name="SaturationValueMarker"
                         Width="14"
                         Height="14"
                         Stroke="White"
                         StrokeThickness="2"
                         Fill="Transparent"
                         IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3"
                                          ShadowDepth="0"
                                          Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Grid x:Name="HueArea"
                  Grid.Column="1"
                  ClipToBounds="True"
                  Cursor="Hand"
                  MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                  MouseMove="HueArea_MouseMove"
                  MouseLeftButtonUp="HueArea_MouseLeftButtonUp">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0"
                                             EndPoint="0.5,1">
                            <GradientStop Color="#FFFF0000" Offset="0.000" />
                            <GradientStop Color="#FFFFFF00" Offset="0.167" />
                            <GradientStop Color="#FF00FF00" Offset="0.333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.500" />
                            <GradientStop Color="#FF0000FF" Offset="0.667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.833" />
                            <GradientStop Color="#FFFF0000" Offset="1.000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="HueMarker"
                        Height="4"
                        BorderBrush="White"
                        BorderThickness="1"
                        Background="#FF222222"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False" />
            </Grid>

            <StackPanel Grid.Column="3">
                <Border x:Name="ColorPreview"
                        Height="72"
                        CornerRadius="4"
                        BorderBrush="#FF8C8C8C"
                        BorderThickness="1"
                        Margin="0,0,0,18" />

                <TextBlock Text="Rot" />
                <TextBox x:Name="RedTextBox"
                         Margin="0,3,0,9"
                         TextChanged="RgbTextBox_TextChanged" />

                <TextBlock Text="Grün" />
                <TextBox x:Name="GreenTextBox"
                         Margin="0,3,0,9"
                         TextChanged="RgbTextBox_TextChanged" />

                <TextBlock Text="Blau" />
                <TextBox x:Name="BlueTextBox"
                         Margin="0,3,0,9"
                         TextChanged="RgbTextBox_TextChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Hex:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <TextBox x:Name="HexTextBox"
                     Grid.Column="1"
                     MaxLength="7"
                     TextChanged="HexTextBox_TextChanged" />
        </Grid>

        <Separator Grid.Row="2"
                   Margin="0,18,0,12" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen"
                    Width="95"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Click="CancelButton_Click" />
            <Button Content="OK"
                    Width="95"
                    Padding="10,6"
                    IsDefault="True"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
